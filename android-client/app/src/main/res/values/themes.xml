<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme. The Compose theme (MuorgTheme) handles all Material 3 colors.
         This XML theme is used for the window background visible before Compose renders. -->
    <style name="Theme.Muorg" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">#1c1917</item>
        <item name="android:statusBarColor">#1c1917</item>
        <item name="android:navigationBarColor">#292524</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Widget text appearances: must use hardcoded values — RemoteViews inflates in a
         foreign process where ?attr/... theme attributes are not available. -->
    <style name="TextAppearance.Widget.Title" parent="android:TextAppearance">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">#FFFFFFFF</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Widget.Artist" parent="android:TextAppearance">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">#CCFFFFFF</item>
    </style>

    <style name="TextAppearance.Widget.Album" parent="android:TextAppearance">
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">#99FFFFFF</item>
    </style>
</resources>
