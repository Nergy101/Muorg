    <!-- Vinyl record outer circle (r=225, center 512,552) -->
    <path
        android:pathData="M512,327 A225,225 0 1,0 512,777 A225,225 0 1,0 512,327 Z"
        android:fillColor="#759346"
        android:strokeColor="#ffffff"
        android:strokeWidth="18"/>

    <!-- Groove ring 1 (r=165) -->
    <path
        android:pathData="M512,387 A165,165 0 1,0 512,717 A165,165 0 1,0 512,387 Z"
        android:fillColor="#00000000"
        android:strokeColor="#665b7c32"
        android:strokeWidth="10"/>

    <!-- Groove ring 2 (r=113) -->
    <path
        android:pathData="M512,439 A113,113 0 1,0 512,665 A113,113 0 1,0 512,439 Z"
        android:fillColor="#00000000"
        android:strokeColor="#665b7c32"
        android:strokeWidth="10"/>

