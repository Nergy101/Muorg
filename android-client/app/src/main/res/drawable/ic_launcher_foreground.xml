    <path
        android:pathData="M512,496 A56,56 0 1,0 512,608 A56,56 0 1,0 512,496 Z"
        android:fillColor="#5b7c32"/>

    <!-- Metallic spindle dot (r=14) -->
    <path android:pathData="M512,538 A14,14 0 1,0 512,566 A14,14 0 1,0 512,538 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="512"
                android:centerY="552"
                android:gradientRadius="14"
                android:startColor="#ffffff"
                android:endColor="#999999"/>
