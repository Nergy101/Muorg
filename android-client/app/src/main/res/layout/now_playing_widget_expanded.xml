<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="12dp"
    android:background="@drawable/widget_background">

    <FrameLayout
        android:layout_width="72dp"
        android:layout_height="72dp">

        <ImageView
            android:id="@+id/widget_cover"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="@string/widget_cover_desc"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/widget_cover_placeholder"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/ic_compact_disk"
            android:tint="#66FFFFFF"
            android:scaleType="centerInside"
            android:contentDescription="@string/widget_cover_desc" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:layout_marginStart="12dp">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Widget.Title"
            android:text="@string/widget_no_track" />

        <TextView
            android:id="@+id/widget_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Widget.Artist"
            android:text="" />

        <TextView
            android:id="@+id/widget_album"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Widget.Album"
            android:text="" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <ImageButton
                android:id="@+id/widget_previous"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="8dp"
                android:scaleType="center"
                android:src="@drawable/ic_previous"
                android:background="@android:color/transparent"
                android:contentDescription="@string/widget_previous" />

            <ImageButton
                android:id="@+id/widget_play_pause"
                android:layout_width="44dp"
                android:layout_height="40dp"
                android:padding="8dp"
                android:scaleType="center"
                android:src="@drawable/ic_play"
                android:background="@android:color/transparent"
                android:contentDescription="@string/widget_play" />

            <ImageButton
                android:id="@+id/widget_next"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="8dp"
                android:scaleType="center"
                android:src="@drawable/ic_next"
                android:background="@android:color/transparent"
                android:contentDescription="@string/widget_next" />

            <ImageButton
                android:id="@+id/widget_favorite"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="8dp"
                android:scaleType="center"
                android:src="@drawable/ic_heart"
                android:background="@android:color/transparent"
                android:contentDescription="@string/widget_toggle_favorite" />

        </LinearLayout>
    </LinearLayout>

</LinearLayout>
