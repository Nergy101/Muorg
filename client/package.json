{
  "name": "muorg",
  "private": true,
  "pnpm": {
    "onlyBuiltDependencies": [
      "core-js",
      "esbuild",
      "vue-demi"
    ]
  },
  "version": "2.26.5",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mock": "VITE_MOCK=1 pnpm tauri dev",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "build:server": "cd ../server && cargo build --release",
    "build:sidecar": "bash ../scripts/copy-sidecar.sh",
    "build:linux": "pnpm build:sidecar && tauri build",
    "build:macos": "pnpm build:sidecar && tauri build",
    "build:windows": "pnpm build:sidecar && tauri build",
    "icon": "tauri icon public/favicon.svg -o src-tauri/icons",
    "check:frontend": "pnpm build",
    "check:rust": "cargo check --manifest-path src-tauri/Cargo.toml && cargo clippy --manifest-path src-tauri/Cargo.toml -- -D warnings",
    "check": "pnpm run check:frontend && pnpm run check:rust"
  },
  "dependencies": {
    "@emoji-mart/data": "^1.2.1",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-process": "~2.3.1",
    "@tauri-apps/plugin-shell": "~2.3.5",
    "@tauri-apps/plugin-updater": "~2.10.1",
    "emoji-mart": "^5.6.0",
    "feather-icons": "^4.29.2",
    "overlayscrollbars": "^2.16.0",
    "pinia": "^3.0.4",
    "vue": "^3.5.39",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/feather-icons": "^4.29.4",
    "@types/node": "^26.1.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "autoprefixer": "^10.5.2",
    "postcss": "^8.5.16",
    "tailwindcss": "^4.3.2",
    "@tailwindcss/postcss": "^4.3.2",
    "typescript": "~6.0.3",
    "vite": "^8.1.3",
    "vue-tsc": "^3.3.6"
  }
}
