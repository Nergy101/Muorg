{
  "name": "muorg",
  "private": true,
  "pnpm": {
    "onlyBuiltDependencies": [
      "core-js",
      "esbuild",
      "vue-demi"
    ]
  },
  "version": "3.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mock": "VITE_MOCK=1 pnpm tauri dev",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "build:server": "cd ../server && cargo build --release",
    "build:sidecar": "bash ../scripts/copy-sidecar.sh",
    "build:linux": "pnpm build:sidecar && tauri build",
    "build:macos": "pnpm build:sidecar && tauri build",
    "build:windows": "pnpm build:sidecar && tauri build",
    "icon": "tauri icon public/favicon.svg -o src-tauri/icons",
    "check:frontend": "pnpm build",
    "check:rust": "cargo check --manifest-path src-tauri/Cargo.toml && cargo clippy --manifest-path src-tauri/Cargo.toml -- -D warnings",
    "check": "pnpm run check:frontend && pnpm run check:rust && pnpm run test:rust",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@emoji-mart/data": "^1.2.1",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-fs": "^2.7.1",
    "@tauri-apps/plugin-process": "~2.4.0",
    "@tauri-apps/plugin-shell": "~2.5.0",
    "@tauri-apps/plugin-updater": "~2.14.0",
    "emoji-mart": "^5.6.0",
    "feather-icons": "^4.29.2",
    "openapi-fetch": "^0.17.0",
    "overlayscrollbars": "^2.16.0",
    "pinia": "^4.1.0",
    "vue": "^3.5.44",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tauri-apps/cli": "^2.12.3",
    "@types/feather-icons": "^4.29.4",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.0.5",
    "@vue/test-utils": "^2.5.1",
    "autoprefixer": "^10.6.1",
    "esbuild": "^0.28.2",
    "happy-dom": "^21.0.3",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  }
}
